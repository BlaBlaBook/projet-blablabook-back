{
  "name": "api",
  "description": "API Blablabook",
  "keywords": [],
  "author": "Team Blablabook",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "====For production====": "",
    "start": "node dist/index.js",
    "build": "tsc",
    "====For development====": "",
    "dev": "node --watch index.ts",
    "format": "npm exec -- biome format ./",
    "format:fix": "npm exec -- biome format --write ./",
    "lint": "npm exec -- biome lint ./",
    "lint:fix": "npm exec -- biome lint --write ./",
    "check": "npm exec -- biome check ./",
    "check:fix": "npm exec -- biome check --write ./",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:name": "prisma migrate dev --name",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset --force",
    "dev:db": "npm run prisma:reset && npm run prisma:generate && npm run prisma:migrate && npm run dev",
    "db:seed": "node --env-file=.env ./src/models/seeding.ts",
    "test": "bash ./tests/scripts/run-tests.sh",
    "test:unit": "vitest run --globals app/tests/units/**/*.test.ts",
    "test:docker": "npm run reset-test-db && vitest run --globals",
    "reset-test-db": "node --loader ts-node/esm tests/setup/reset-test-db.ts"
  },
  "dependencies": {
    "@dicebear/avatars": "^4.10.8",
    "@dicebear/collection": "^9.2.4",
    "@dicebear/core": "^9.2.4",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.2.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "resend": "^6.6.0",
    "sanitize-html": "^2.17.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.4",
    "@types/pg": "^8.15.6",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^7.2.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
